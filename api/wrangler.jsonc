{
  // Configuração do deploy da API no Cloudflare.
  //
  // POR QUE ESTE ARQUIVO EXISTE
  // ---------------------------
  // Sem ele, o `npx wrangler deploy` tenta ADIVINHAR a configuração, detecta
  // Vite e tenta instalar o plugin Vite da Cloudflare, que exige Vite >= 6.
  // Aqui não há Vite nenhum — mas a detecção acontece antes de o wrangler
  // saber disso, e o deploy falha com uma mensagem que não tem relação com o
  // problema. Declarar a configuração faz ele parar de adivinhar.

  "name": "projetofetin",
  "compatibility_date": "2026-08-21",
  "main": "worker/index.js",

  // Banco D1 (SQLite gerenciado). JÁ EXISTE — foi criado com
  // `npx wrangler d1 create vigilancia` e está carregado.
  //
  // O `database_id` não é segredo: identifica o banco, não autoriza acesso.
  // Quem escreve nele precisa das credenciais da conta Cloudflare.
  "d1_databases": [
    {
      // O binding é DB, não "vigilancia". O worker/index.js lê `env.DB`; o
      // snippet que o `d1 create` imprime sugere usar o nome do banco como
      // binding, e trocar quebraria com "Banco não vinculado" — erro difícil
      // de rastrear até a causa.
      "binding": "DB",
      "database_name": "vigilancia",
      "database_id": "659ee2d6-e140-42eb-a9fa-243929329da0"
    }
  ]

  // Sem bloco `assets`: esta API não serve arquivos estáticos. O painel do
  // AeroScan continua no GitHub Pages, onde já está, e chama esta API por
  // HTTP — o CORS está liberado no worker justamente para isso.
}
